generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Building {
  id                 String   @id @default(uuid())
  name               String   @unique
  display_name       String
  texture_name       String
  special_texture    String[] // For things like "pipes", "wires" that has different texture when draw on canvas
  width              Int
  height             Int
  placement_offset   Json // JSONB
  scene_layer        Int      @default(0)
  object_layer       Int      @default(0)
  tile_layer         Int      @default(0)
  search_term        String[]
  is_drag_build      Boolean // "DragBuild" field
  is_need_foundation Boolean // "ContinuouslyCheckFoundation" field
  is_foundation      Boolean
  category           String? // "buildingAndSubcategoryDataPairs"
  type               String?
  view_mode          Int?
  build_rule         Int
  rotation_permit    Int      @default(0)

  // Store as JSONB instead of separate tables
  materials  Json // JSONB: Material[]
  conduit    Json? // JSONB: Conduit | null
  logic_port Json // JSONB: LogicPort[]
  power_port Json? // JSONB: PowerPort | null

  // Indexes for query optimization
  @@index([category])
  @@index([display_name])
  @@index([search_term], type: Gin) // GIN index for array search
}

model User {
  id         String      @id @default(uuid())
  name       String
  email      String      @unique
  avatar     String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  blueprints Blueprint[]

  @@index([email])
}

model Blueprint {
  id          String    @id @default(uuid())
  shareId     String    @unique
  name        String
  buildings   Json // JSONB - compressed building data
  connections Json? // JSONB - compressed connection data (optional)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String?
  guestId     String? // Track anonymous guest creator for migration
  user        User?     @relation(fields: [userId], references: [id])

  @@index([shareId])
  @@index([createdAt])
  @@index([userId])
}
